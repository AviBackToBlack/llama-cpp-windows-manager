<Window x:Class="LocalLlmConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="llama.cpp Windows Manager v2.0.0" MinWidth="1180" MinHeight="760" Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBack}"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="8"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource AppBack}"
          CornerRadius="8"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource AppBack}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="18,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="llama.cpp Windows Manager"
                     Foreground="{DynamicResource TextSoft}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="AppVersionText"
                       Text="v2.0.0"
                     Foreground="{DynamicResource Accent}"
                     FontSize="11.5"
                     FontWeight="SemiBold"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="-" Click="MinimizeButton_Click"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="[ ]" Click="MaximizeButton_Click"/>
          <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" Content="X" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="18,0,18,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- Sidebar navigation -->
      <Border Grid.Column="0"
              Style="{StaticResource Panel}"
              Background="{DynamicResource SidebarBack}"
              BorderBrush="{DynamicResource PanelBorderStrong}"
              Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Language selector at top -->
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <ComboBox x:Name="LanguageCombo"
                      MinHeight="27"
                      Padding="8,2"
                      SelectionChanged="LanguageCombo_SelectionChanged"/>
            <Border Height="1"
                    Background="{DynamicResource PanelBorder}"
                    Margin="0,12,0,0"/>
          </StackPanel>
          <!-- Navigation buttons -->
          <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" Click="ShowOverview_Click"/>
            <Button x:Name="ModelsNavButton" Style="{StaticResource NavButton}" Click="ShowModels_Click"/>
            <Button x:Name="RuntimesNavButton" Style="{StaticResource NavButton}" Click="ShowRuntimes_Click"/>
            <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="ShowSettings_Click"/>
            <Button x:Name="OpenCodeNavButton" Style="{StaticResource NavButton}" Click="ShowOpenCode_Click"/>
            <Button x:Name="LifetimeNavButton" Style="{StaticResource NavButton}" Click="ShowLifetime_Click"/>
            <Button x:Name="LogsNavButton" Style="{StaticResource NavButton}" Click="ShowLogs_Click"/>
            <Border Height="1"
                    Background="{DynamicResource PanelBorder}"
                    Margin="0,8,0,10"/>
            <TextBlock x:Name="ToolsNavLabel"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="12,0,0,8"/>
            <Button x:Name="WindowsNavButton" Style="{StaticResource NavButton}" Click="ShowWindows_Click"/>
            <Button x:Name="WslLinuxNavButton" Style="{StaticResource NavButton}" Click="ShowWslLinux_Click"/>
          </StackPanel>
          <Border Grid.Row="3"
                  Background="{DynamicResource InputBack}"
                  BorderBrush="{DynamicResource AccentStrong}"
                  BorderThickness="3,1,1,1"
                  CornerRadius="8"
                  Padding="11,10"
                  Margin="0,12,0,0">
            <StackPanel>
              <TextBlock x:Name="CurrentStatusLabel"
                         Foreground="{DynamicResource TextMuted}"
                         FontSize="11.5"
                         FontWeight="SemiBold"
                         Margin="0,0,0,4"/>
              <TextBlock x:Name="AppStatusText"
                         Foreground="{DynamicResource TextMain}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2">
            <Button x:Name="UpdatesNavButton" Style="{StaticResource NavButton}" Click="ShowUpdates_Click"/>
            <Button x:Name="HelpNavButton" Style="{StaticResource NavButton}" Click="ShowHelp_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Panel}" Padding="0">
        <ContentControl x:Name="PageHost"/>
      </Border>
      </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
