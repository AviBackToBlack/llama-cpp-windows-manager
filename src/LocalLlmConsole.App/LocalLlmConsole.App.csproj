<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LlamaCppWindowsManager</AssemblyName>
    <RootNamespace>LocalLlmConsole</RootNamespace>
    <AssemblyTitle>llama.cpp Windows Manager</AssemblyTitle>
    <Product>llama.cpp Windows Manager</Product>
    <RepositoryUrl>https://github.com/alekk89/llama-cpp-windows-manager</RepositoryUrl>
    <Version>1.1.7</Version>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <FileVersion>1.1.7.0</FileVersion>
    <InformationalVersion>v1.1.7</InformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.27" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tools\Build-LlamaCppRuntime.ps1" />
    <EmbeddedResource Include="Localization\Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.bg.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.de.json" WithCulture="false" />
